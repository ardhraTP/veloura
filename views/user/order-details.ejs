<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | Veloura</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/profile.css">
    <script src="/js/prevent-back.js"></script>
    <style>
        body {
            background-color: #FAF6F0;
            color: #2C2C2C;
            font-family: 'Inter', sans-serif;
        }

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 120px 20px 80px 20px;
            display: flex;
            gap: 40px;
        }

        .content-area {
            flex: 1;
            min-width: 0; /* Prevent flex blowout */
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 500;
            color: #5C1E28;
            margin-top: 0;
            margin-bottom: 35px;
            letter-spacing: 0.5px;
        }

        /* Product Card Layout */
        .product-card {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border: 1px solid #F0ECE6;
        }

        .product-info-left {
            display: flex;
            align-items: center;
            gap: 24px;
            flex: 1;
        }

        .product-image {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            background-color: #FAF6F0;
        }

        .product-details {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 500;
            color: #2C2C2C;
            margin: 0;
            line-height: 1.2;
        }

        .product-price {
            font-size: 16px;
            font-weight: 600;
            color: #5C1E28;
            margin: 0;
        }

        .product-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 4px;
        }

        .badge-pill {
            background-color: #EAE5DF;
            color: #666666;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 12px;
            border-radius: 20px;
            text-transform: capitalize;
        }

        .product-action-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 15px;
            min-width: 180px;
        }

        /* Status Badge style */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background-color: #E8F8EE;
            color: #19B24B;
            font-size: 11px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 6px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .status-badge.cancelled {
            background-color: #FDE8E8;
            color: #E02424;
        }

        .status-badge.returned {
            background-color: #FEF08A;
            color: #854D0E;
        }

        .status-badge.pending, .status-badge.ordered {
            background-color: #FEF3C7;
            color: #D97706;
        }

        .status-badge.processing {
            background-color: #FDF2E9;
            color: #B06000;
        }

        .status-badge.shipped {
            background-color: #E0F2FE;
            color: #0284c7;
        }

        .status-badge.out-for-delivery {
            background-color: #FAF5FF;
            color: #7c3aed;
        }

        /* Cancel/Return Buttons */
        .btn-order-action {
            width: 100%;
            max-width: 180px;
            padding: 10px 20px;
            background-color: #D92525;
            color: #FFFFFF;
            border: 1px solid #D92525;
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .btn-order-action:hover {
            background-color: #B21B1B;
            border-color: #B21B1B;
            box-shadow: 0 4px 10px rgba(217, 37, 37, 0.15);
        }

        /* Two Column Layout details */
        .details-layout-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            align-items: start;
        }

        .details-column-stacked {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .info-card {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #F0ECE6;
        }

        .card-header-title {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #5C1E28;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 0;
            margin-bottom: 20px;
            border-bottom: 1px solid #FAF6F0;
            padding-bottom: 10px;
        }

        /* Delivered Address styling */
        .address-name {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 600;
            color: #2C2C2C;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .address-text {
            font-size: 14px;
            line-height: 1.8;
            color: #555555;
            margin-bottom: 15px;
        }

        .address-phone {
            font-size: 14px;
            color: #2C2C2C;
            font-weight: 500;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .address-phone i {
            color: #5C1E28;
        }

        /* Total Summary Styling */
        .summary-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            color: #555555;
        }

        .summary-row.total-row {
            border-top: 1px solid #F0ECE6;
            padding-top: 15px;
            margin-top: 5px;
            color: #2C2C2C;
        }

        .total-label {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 500;
        }

        .total-value {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 600;
            color: #5C1E28;
        }

        .text-green {
            color: #19B24B;
            font-weight: 600;
        }

        /* Review Card Styling (Delivered state) */
        .review-title-serif {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 500;
            color: #2C2C2C;
            margin-top: 0;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-size: 11px;
            font-weight: 600;
            color: #5C1E28;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: block;
            margin-bottom: 8px;
        }

        /* Rating Stars Selector */
        .rating-selector {
            display: flex;
            gap: 8px;
            font-size: 20px;
            color: #CCCCCC;
            cursor: pointer;
            margin-bottom: 5px;
        }

        .rating-selector i.active {
            color: #5C1E28;
        }

        .review-input, .review-textarea {
            width: 100%;
            background-color: #FAF6F0;
            border: 1px solid #EAE5DF;
            border-radius: 4px;
            padding: 12px 15px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #2C2C2C;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.3s ease;
        }

        .review-input:focus, .review-textarea:focus {
            border-color: #5C1E28;
        }

        .review-textarea {
            height: 100px;
            resize: none;
        }

        .btn-submit-review {
            width: 100%;
            background-color: #5C1E28;
            color: #FFFFFF;
            border: 1px solid #5C1E28;
            border-radius: 4px;
            padding: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .btn-submit-review:hover {
            background-color: #3b1118;
            border-color: #3b1118;
            box-shadow: 0 4px 10px rgba(92, 30, 40, 0.15);
        }

        /* Download Invoice Button container */
        .invoice-download-container {
            margin-top: 20px;
            display: flex;
            justify-content: flex-end;
        }

        .btn-download-invoice {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: auto;
            background-color: #5C1E28;
            color: #FFFFFF;
            border: 1px solid #5C1E28;
            border-radius: 6px;
            padding: 9px 20px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .btn-download-invoice:hover {
            background-color: #3b1118;
            border-color: #3b1118;
            box-shadow: 0 4px 10px rgba(92, 30, 40, 0.15);
        }

        /* Responsive Breakpoints */
        @media (max-width: 992px) {
            .main-container {
                flex-direction: column;
                gap: 30px;
                padding-top: 100px;
            }

            .sidebar {
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            .product-card {
                flex-direction: column;
                align-items: flex-start;
                padding: 20px;
            }

            .product-action-right {
                width: 100%;
                align-items: flex-start;
                min-width: 0;
            }

            .btn-order-action {
                max-width: 100%;
            }

            .details-layout-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
        }

        /* Cancel Order Modal Styles */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            animation: fadeIn 0.3s ease;
        }

        .cancel-modal-content {
            background-color: #FFFFFF;
            width: 90%;
            max-width: 500px;
            border-radius: 12px;
            padding: 40px;
            position: relative;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            box-sizing: border-box;
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .close-modal-btn {
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 24px;
            color: #888888;
            cursor: pointer;
            transition: color 0.2s ease;
        }
        .close-modal-btn:hover {
            color: #5C1E28;
        }

        .modal-title {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 500;
            color: #5C1E28;
            margin-top: 0;
            margin-bottom: 8px;
        }

        .modal-subtitle {
            font-size: 13px;
            color: #666666;
            margin-top: 0;
            margin-bottom: 25px;
        }

        .reasons-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 280px;
            overflow-y: auto;
            padding-right: 5px;
            margin-bottom: 20px;
        }

        .reason-option-card {
            display: flex;
            align-items: center;
            gap: 15px;
            background-color: #FFFFFF;
            border: 1px solid #EAE5DF;
            border-radius: 6px;
            padding: 12px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .reason-option-card:hover {
            border-color: #5C1E28;
            background-color: #FAF6F0;
        }

        .reason-option-card input[type="radio"] {
            display: none;
        }

        .custom-radio {
            width: 16px;
            height: 16px;
            border: 2px solid #CCCCCC;
            border-radius: 50%;
            display: inline-block;
            position: relative;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .reason-option-card input[type="radio"]:checked + .custom-radio {
            border-color: #5C1E28;
        }

        .reason-option-card input[type="radio"]:checked + .custom-radio::after {
            content: '';
            width: 8px;
            height: 8px;
            background-color: #5C1E28;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .reason-text {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 500;
            color: #2C2C2C;
        }

        .optional-comment-group {
            margin-bottom: 25px;
        }

        .form-label-cancel {
            font-size: 11px;
            font-weight: 600;
            color: #5C1E28;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
            margin-bottom: 8px;
        }

        .cancel-textarea {
            width: 100%;
            height: 70px;
            background-color: #FAF6F0;
            border: 1px solid #EAE5DF;
            border-radius: 6px;
            padding: 10px 15px;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            outline: none;
            resize: none;
            transition: border-color 0.2s ease;
        }

        .cancel-textarea:focus {
            border-color: #5C1E28;
        }

        .modal-actions {
            display: flex;
            gap: 15px;
        }

        .btn-modal-submit {
            flex: 1;
            background-color: #5C1E28;
            color: #FFFFFF;
            border: 1px solid #5C1E28;
            border-radius: 4px;
            padding: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-modal-submit:hover {
            background-color: #3b1118;
            border-color: #3b1118;
        }

        .btn-modal-cancel {
            flex: 1;
            background-color: #FFFFFF;
            color: #5C1E28;
            border: 1px solid #5C1E28;
            border-radius: 4px;
            padding: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-modal-cancel:hover {
            background-color: #FAF6F0;
        }

        /* Custom Checkbox Outline Styling for Return reasons */
        .custom-checkbox-outline {
            width: 16px;
            height: 16px;
            border: 2px solid #CCCCCC;
            border-radius: 3px;
            display: inline-block;
            position: relative;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .reason-option-card input[type="radio"]:checked + .custom-checkbox-outline {
            border-color: #5C1E28;
            background-color: #5C1E28;
        }

        .reason-option-card input[type="radio"]:checked + .custom-checkbox-outline::after {
            content: '✔';
            font-size: 10px;
            color: #FFFFFF;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .btn-modal-text-cancel {
            background: none;
            border: none;
            color: #888888;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: pointer;
            text-transform: uppercase;
            transition: color 0.2s ease;
            padding: 0;
        }

        .btn-modal-text-cancel:hover {
            color: #5C1E28;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="main-container">
        <%- include('../partials/profile-sidebar') %>

        <main class="content-area">
            <h1 class="page-title">Order Details</h1>
            <div style="margin-top: -25px; margin-bottom: 30px; font-size: 14px; color: #666666; font-weight: 500; letter-spacing: 0.5px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center;">
                <div>Order ID: <span style="color: #5C1E28; font-weight: 600;"><%= order.orderId %></span></div>
                <span style="color: #ccc;">|</span>
                <div>Payment Method: <span style="color: #2C2C2C; font-weight: 600;">
                    <% if (order.paymentMethod === 'COD') { %>
                        Cash on Delivery
                    <% } else if (order.paymentMethod === 'Online' || order.paymentMethod === 'Online Payment') { %>
                        Online Payment
                    <% } else if (order.paymentMethod === 'Wallet') { %>
                        Wallet Payment
                    <% } else { %>
                        <%= order.paymentMethod || 'N/A' %>
                    <% } %>
                </span></div>
            </div>

            <% if (order.paymentStatus === 'Failed' && order.orderStatus !== 'Cancelled') { %>
                <div style="background-color: #FDF2F2; border: 1px solid #F8B4B4; color: #9B1C1C; padding: 16px 20px; border-radius: 12px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; gap: 15px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <i class="fas fa-exclamation-triangle" style="font-size: 20px;"></i>
                        <div>
                            <strong style="display: block; font-size: 15px; margin-bottom: 2px;">Payment Failed</strong>
                            <span style="font-size: 13px; opacity: 0.9;">We could not process your payment for this order. Please retry payment to complete your purchase.</span>
                        </div>
                    </div>
                    <button type="button" 
                            onclick="retryPayment('<%= order.orderId %>')"
                            style="background-color: #5C1E28; color: #ffffff; border: none; padding: 10px 20px; border-radius: 20px; font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; text-transform: uppercase; white-space: nowrap; box-shadow: 0 2px 8px rgba(92,30,40,0.2);">
                        <i class="fas fa-redo"></i> Retry Payment
                    </button>
                </div>
            <% } %>

            <!-- Handle order status variable mapping safety -->
            <% 
               const isDelivered = order.orderStatus === 'Delivered'; 
               
               let displaySubtotal = order.subtotal;
               let displayTax = order.tax;
               let displayTotal = order.totalAmount;

               if (order.orderStatus === 'Cancelled' || order.totalAmount === 0) {
                   displaySubtotal = order.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                   displayTax = Math.round(displaySubtotal * 0.05);
                   displayTotal = Math.max(0, displaySubtotal + (order.shippingFee || 0) + displayTax - (order.discount || 0));
               }
            %>

            <!-- Loop through order items. We can group them or render each item card as requested. -->
            <% if (order.items && order.items.length > 0) { %>
                <% order.items.forEach(function(item) { %>
                    <!-- Product Card -->
                    <div class="product-card">
                        <div class="product-info-left">
                            <img src="<%= (item.variant && item.variant.images && item.variant.images.length > 0) ? item.variant.images[0] : '/images/default.jpg' %>" alt="<%= (item.product && item.product.productName) ? item.product.productName : 'Product Image' %>" class="product-image">
                            
                            <div class="product-details">
                                <h3 class="product-name"><%= (item.product && item.product.productName) ? item.product.productName : 'Product Name' %></h3>
                                <p class="product-price">₹<%= item.price ? item.price.toFixed(2) : '0.00' %></p>
                                
                                <div class="product-badges">
                                    <% if (item.variant && item.variant.color) { %>
                                        <span class="badge-pill">Shade: <%= item.variant.color %></span>
                                    <% } %>
                                    <span class="badge-pill">Qty: <%= item.quantity %></span>
                                </div>
                            </div>
                        </div>

                        <div class="product-action-right">
                            <!-- Product Status Badge -->
                            <% if (item.itemStatus === 'Delivered' || (typeof item.itemStatus === 'undefined' && isDelivered)) { %>
                                <div class="status-badge">
                                    <i class="fas fa-check-circle"></i> Delivered
                                </div>
                                <% 
                                   const prodIdStr = item.product ? (item.product._id ? item.product._id.toString() : item.product.toString()) : '';
                                   const prodNameEscaped = (item.product && item.product.productName) ? item.product.productName.replace(/'/g, "\\'").replace(/"/g, '&quot;') : 'Product';
                                   const existingProdReview = (typeof userReviews !== 'undefined' && userReviews && Array.isArray(userReviews)) 
                                       ? userReviews.find(r => r.product && r.product.toString() === prodIdStr) 
                                       : null;
                                %>
                                <% if (existingProdReview) { %>
                                    <div style="font-size: 11px; color: #10B981; font-weight: 600; margin-top: 4px; text-align: right;">
                                        <i class="fas fa-check-circle"></i> <%= existingProdReview.status === 'Approved' ? 'Reviewed' : 'Review Pending' %>
                                    </div>
                                <% } else { %>
                                    <button type="button" 
                                            class="btn-order-action" 
                                            style="background-color: #5C1E28; border-color: #5C1E28;"
                                            onclick="openReviewModal('<%= order._id %>', '<%= prodIdStr %>', '<%= prodNameEscaped %>')">
                                        <i class="fas fa-star" style="margin-right: 4px;"></i> Write Review
                                    </button>
                                <% } %>
                                <button class="btn-order-action" style="margin-top: 6px;" onclick="handleReturnOrder('<%= order._id %>', '<%= item._id %>')">Return</button>
                            <% } else if (item.itemStatus === 'Cancelled' || order.orderStatus === 'Cancelled') { %>
                                <div class="status-badge cancelled">
                                    <i class="fas fa-times-circle"></i> Cancelled
                                </div>
                                <% const reasonToShow = item.cancellationReason || order.cancellationReason; %>
                                <% if (reasonToShow) { %>
                                    <div style="font-size: 11px; color: #E02424; margin-top: 5px; font-weight: 500; text-align: right; max-width: 180px;">Reason: <%= reasonToShow %></div>
                                <% } %>
                            <% } else if (item.itemStatus === 'Returned') { %>
                                <div class="status-badge returned">
                                    <i class="fas fa-undo-alt"></i> Returned
                                </div>
                                <% 
                                   const prodIdStr = item.product ? (item.product._id ? item.product._id.toString() : item.product.toString()) : '';
                                   const prodNameEscaped = (item.product && item.product.productName) ? item.product.productName.replace(/'/g, "\\'").replace(/"/g, '&quot;') : 'Product';
                                   const existingProdReview = (typeof userReviews !== 'undefined' && userReviews && Array.isArray(userReviews)) 
                                       ? userReviews.find(r => r.product && r.product.toString() === prodIdStr) 
                                       : null;
                                %>
                                <% if (existingProdReview) { %>
                                    <div style="font-size: 11px; color: #10B981; font-weight: 600; margin-top: 4px; text-align: right;">
                                        <i class="fas fa-check-circle"></i> <%= existingProdReview.status === 'Approved' ? 'Reviewed' : 'Review Pending' %>
                                    </div>
                                <% } else { %>
                                    <button type="button" 
                                            class="btn-order-action" 
                                            style="background-color: #5C1E28; border-color: #5C1E28; margin-top: 6px;"
                                            onclick="openReviewModal('<%= order._id %>', '<%= prodIdStr %>', '<%= prodNameEscaped %>')">
                                        <i class="fas fa-star" style="margin-right: 4px;"></i> Write Review
                                    </button>
                                <% } %>
                            <% } else if (item.itemStatus === 'Return Requested') { %>
                                <div class="status-badge pending">
                                    <i class="fas fa-history"></i> Return Requested
                                </div>
                            <% } else if (item.itemStatus === 'Return Rejected') { %>
                                <div class="status-badge cancelled">
                                    <i class="fas fa-times-circle"></i> Return Rejected
                                </div>
                                <% if (item.returnRejectionReason) { %>
                                    <div style="font-size: 11px; color: #E02424; margin-top: 5px; font-weight: 500; text-align: right; max-width: 180px;">Reason: <%= item.returnRejectionReason %></div>
                                <% } %>
                            <% } else if (item.itemStatus === 'Out for Delivery') { %>
                                <div class="status-badge out-for-delivery">
                                    <i class="fas fa-truck"></i> Out for Delivery
                                </div>
                            <% } else { %>
                                <% 
                                    const currentStatus = item.itemStatus || order.orderStatus || 'Ordered';
                                    let statusClass = '';
                                    if (currentStatus === 'Processing') statusClass = 'processing';
                                    else if (currentStatus === 'Shipped') statusClass = 'shipped';
                                    else if (currentStatus === 'Pending' || currentStatus === 'Ordered') statusClass = 'pending';
                                %>
                                <div class="status-badge <%= statusClass %>">
                                    <i class="fas fa-check-circle"></i> <%= currentStatus %>
                                </div>
                                <button class="btn-order-action" onclick="handleCancelOrder('<%= order._id %>', '<%= item._id %>')">Cancel Order</button>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No items found in this order.</p>
            <% } %>

            <!-- Delivered Address and Total Summary Side-by-Side -->
            <div class="details-layout-grid">
                <!-- Delivered Address Card -->
                <div class="info-card">
                    <h4 class="card-header-title">Delivered Address</h4>
                    <% if (order.deliveryAddress) { %>
                        <h5 class="address-name"><%= order.deliveryAddress.fullName %></h5>
                        <p class="address-text">
                            <%= order.deliveryAddress.address %><br>
                            <%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %><br>
                            - <%= order.deliveryAddress.pincode %>
                        </p>
                        <p class="address-phone">
                            <i class="fas fa-phone-alt"></i> +91 <%= order.deliveryAddress.phone %>
                        </p>
                    <% } else { %>
                        <p>No address information available.</p>
                    <% } %>
                </div>

                <!-- Total Summary Card -->
                <div class="info-card">
                    <h4 class="card-header-title">Total Summary</h4>
                    <div class="summary-list">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₹<%= displaySubtotal ? displaySubtotal.toFixed(2) : '0.00' %></span>
                        </div>
                        <div class="summary-row">
                            <span>Shipping</span>
                            <span class="text-green"><%= (!order.shippingFee || order.shippingFee === 0) ? 'FREE' : '₹' + order.shippingFee.toFixed(2) %></span>
                        </div>
                        <% if (displayTax && displayTax > 0) { %>
                            <div class="summary-row">
                                <span>Tax (5%)</span>
                                <span>₹<%= displayTax.toFixed(2) %></span>
                            </div>
                        <% } %>
                        <% if (order.discount && order.discount > 0) { %>
                            <div class="summary-row">
                                <span>Coupon Discount <%= (order.coupon && order.coupon.code) ? '(' + order.coupon.code + ')' : '' %></span>
                                <span style="color: #27ae60;">₹<%= order.discount.toFixed(2) %></span>
                            </div>
                        <% } %>
                        <div class="summary-row">
                            <span>Payment Method</span>
                            <span style="font-weight: 600; color: #2C2C2C;">
                                <% if (order.paymentMethod === 'COD') { %>
                                    Cash on Delivery
                                <% } else if (order.paymentMethod === 'Online' || order.paymentMethod === 'Online Payment') { %>
                                    Online Payment
                                <% } else if (order.paymentMethod === 'Wallet') { %>
                                    Wallet Payment
                                <% } else { %>
                                    <%= order.paymentMethod || 'N/A' %>
                                <% } %>
                            </span>
                        </div>
                        <div class="summary-row total-row">
                            <span class="total-label">Total</span>
                            <span class="total-value">₹<%= displayTotal ? displayTotal.toFixed(2) : '0.00' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Download Invoice Option (Last) -->
            <% if (isDelivered || order.orderStatus === 'Delivered') { %>
                <div class="invoice-download-container" style="margin-top: 25px;">
                    <a href="/profile/orders/<%= order._id %>/invoice" class="btn-download-invoice">
                        Download Invoice PDF <i class="fas fa-download"></i>
