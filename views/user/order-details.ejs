    <%- include('../partials/footer') %>

    <!-- Inline JavaScript Helpers for Ratings and Dynamic Popups -->
    <script>
        // Check session for success messages
        document.addEventListener('DOMContentLoaded', function() {
            const successMsg = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
            const errorMsg = "<%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %>";
            if (successMsg) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Success!',
                        text: successMsg,
                        icon: 'success',
                        confirmButtonColor: '#5C1E28'
                    });
                } else {
                    alert(successMsg);
                }
            } else if (errorMsg) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Error!',
                        text: errorMsg,
                        icon: 'error',
                        confirmButtonColor: '#5C1E28'
                    });
                } else {
                    alert(errorMsg);
                }
            }
        });

        // Interactive Star Rating Selectors
        document.addEventListener('DOMContentLoaded', function() {
            const stars = document.querySelectorAll('.rating-star-btn');
            const ratingInput = document.getElementById('selected-rating-value');
            
            if (stars.length > 0 && ratingInput) {
                stars.forEach(function(star) {
                    star.addEventListener('click', function() {
                        const val = parseInt(star.getAttribute('data-value'));
                        ratingInput.value = val;
                        updateStars(val);
                    });
                    
                    star.addEventListener('mouseover', function() {
                        const val = parseInt(star.getAttribute('data-value'));
                        highlightStars(val);
                    });
                    
                    star.addEventListener('mouseout', function() {
                        const currentVal = parseInt(ratingInput.value) || 0;
                        updateStars(currentVal);
                    });
                });
            }

            function highlightStars(val) {
                stars.forEach(function(s) {
                    const sVal = parseInt(s.getAttribute('data-value'));
                    if (sVal <= val) {
                        s.className = 'fas fa-star rating-star-btn active';
                    } else {
                        s.className = 'far fa-star rating-star-btn';
                    }
                });
            }

            function updateStars(val) {
                stars.forEach(function(s) {
                    const sVal = parseInt(s.getAttribute('data-value'));
                    if (sVal <= val) {
                        s.className = 'fas fa-star rating-star-btn active';
                    } else {
                        s.className = 'far fa-star rating-star-btn';
                    }
                });
            }
        });

        // Cancel order modal toggle handlers
        function handleCancelOrder(orderId, itemId) {
            document.getElementById('cancel-modal-order-id').value = orderId;
            document.getElementById('cancel-modal-item-id').value = itemId;
            document.getElementById('cancel-order-modal').style.display = 'flex';
        }

        function closeCancelModal() {
            document.getElementById('cancel-order-modal').style.display = 'none';
            document.getElementById('cancel-modal-comment').value = '';
        }

        function submitCancelOrderForm(event) {
            event.preventDefault();
            const orderId = document.getElementById('cancel-modal-order-id').value;
            const itemId = document.getElementById('cancel-modal-item-id').value;
            const reason = document.querySelector('input[name="reason"]:checked').value;
            const comment = document.getElementById('cancel-modal-comment').value;

            fetch('/profile/orders/' + orderId + '/cancel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    itemId: itemId,
                    reason: reason,
                    comment: comment
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeCancelModal();
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Cancelled',
                            text: 'Your order item has been cancelled.',
                            icon: 'success',
                            confirmButtonColor: '#5C1E28'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        alert('Order item cancelled successfully.');
                        window.location.reload();
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Error', data.message || 'Failed to cancel order.', 'error');
                    } else {
                        alert(data.message || 'Failed to cancel order.');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', 'An error occurred. Please try again.', 'error');
                } else {
                    alert('An error occurred. Please try again.');
                }
            });
        }

        // Return order modal toggle handlers
        function handleReturnOrder(orderId, itemId) {
            document.getElementById('return-modal-order-id').value = orderId;
            document.getElementById('return-modal-item-id').value = itemId;
            document.getElementById('return-order-modal').style.display = 'flex';
        }

        function closeReturnModal() {
            document.getElementById('return-order-modal').style.display = 'none';
            document.getElementById('return-modal-other-comment').value = '';
        }

        function submitReturnOrderForm(event) {
            event.preventDefault();
            const orderId = document.getElementById('return-modal-order-id').value;
            const itemId = document.getElementById('return-modal-item-id').value;
            const selectedRadio = document.querySelector('input[name="returnReason"]:checked');
            const otherComment = document.getElementById('return-modal-other-comment').value.trim();

            if (!selectedRadio) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', 'Please select a reason for return.', 'warning');
                } else {
                    alert('Please select a reason for return.');
                }
                return;
            }

            let reason = selectedRadio.value;

            // Validation logic for Mandatory Other reason
            if (reason === 'Other') {
                if (!otherComment) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Required', 'Please fill out the reason description field.', 'warning');
                    } else {
                        alert('Please fill out the reason description field.');
                    }
                    return;
                }
                reason = otherComment;
            } else if (otherComment) {
                // Append optional comment to selected reason if provided
                reason += ' - ' + otherComment;
            }

            fetch('/profile/orders/' + orderId + '/return', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    itemId: itemId,
                    reason: reason
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeReturnModal();
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Submitted',
                            text: 'Your return request has been submitted successfully.',
                            icon: 'success',
                            confirmButtonColor: '#5C1E28'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        alert('Return request submitted successfully.');
                        window.location.reload();
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Error', data.message || 'Failed to submit return request.', 'error');
                    } else {
                        alert(data.message || 'Failed to submit return request.');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', 'An error occurred. Please try again.', 'error');
                } else {
                    alert('An error occurred. Please try again.');
                }
            });
        }
    </script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        async function retryPayment(orderId) {
            try {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Initializing Payment...',
                        text: 'Please wait',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });
                }

                const response = await fetch('/order/retry-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: orderId })
                });

                const data = await response.json();
                if (typeof Swal !== 'undefined') Swal.close();

                if (!data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Stock / Payment Error',
                            text: data.message || 'Unable to retry payment.',
                            confirmButtonColor: '#5c1e28'
                        });
                    } else {
                        alert(data.message || 'Unable to retry payment.');
                    }
                    return;
                }

                const options = {
                    key: data.keyId,
                    amount: Math.round(data.amount * 100),
                    currency: 'INR',
                    name: 'Veloura',
                    description: 'Retry Payment for Order ' + data.orderId,
                    order_id: data.razorpayOrderId,
                    prefill: {
                        name: data.userName || '',
                        email: data.userEmail || '',
                        contact: data.userPhone || ''
                    },
                    theme: { color: '#5c1e28' },
                    handler: async function (paymentResponse) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Verifying Payment...',
                                text: 'Please wait',
                                allowOutsideClick: false,
                                didOpen: () => { Swal.showLoading(); }
                            });
                        }

                        try {
                            const verifyRes = await fetch('/checkout/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: paymentResponse.razorpay_order_id,
                                    razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                    razorpay_signature: paymentResponse.razorpay_signature,
                                    orderId: data.orderId
                                })
                            });

                            const verifyData = await verifyRes.json();
                            if (typeof Swal !== 'undefined') Swal.close();

                            if (verifyData.success) {
                                if (typeof Swal !== 'undefined') {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Payment Successful!',
                                        text: 'Your payment has been received successfully.',
                                        confirmButtonColor: '#5c1e28'
                                    }).then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    alert('Payment Successful!');
                                    window.location.reload();
                                }
                            } else {
                                if (typeof Swal !== 'undefined') {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Verification Failed',
                                        text: verifyData.message || 'Payment verification failed.',
                                        confirmButtonColor: '#5c1e28'
                                    });
                                } else {
                                    alert(verifyData.message || 'Payment verification failed.');
                                }
                            }
                        } catch (err) {
                            console.error('Error verifying payment:', err);
                            if (typeof Swal !== 'undefined') Swal.close();
                            alert('Failed to verify payment.');
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function () {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Payment Failed',
                            text: 'Payment was not completed. You can try again anytime.',
                            confirmButtonColor: '#5c1e28'
                        });
                    } else {
                        alert('Payment was not completed.');
                    }
                });
                rzp.open();
            } catch (error) {
                console.error('Error retrying payment:', error);
                if (typeof Swal !== 'undefined') Swal.close();
                alert('A network error occurred. Please try again.');
            }
        }

        // ── Per-Product Review Modal Handlers ──────────────────────
        let currentModalRating = 0;

        function openReviewModal(orderId, productId, productName) {
            document.getElementById('modal-order-id').value = orderId;
            document.getElementById('modal-product-id').value = productId;
            document.getElementById('review-modal-product-name').textContent = 'Product: ' + productName;
            document.getElementById('modal-review-title').value = '';
            document.getElementById('modal-review-comment').value = '';
            
            setModalRating(0);
            document.getElementById('product-review-modal').style.display = 'flex';
        }

        function closeReviewModal() {
            document.getElementById('product-review-modal').style.display = 'none';
        }

        function setModalRating(val) {
            currentModalRating = val;
            document.getElementById('modal-rating-value').value = val;
            const stars = document.querySelectorAll('.modal-star');
            stars.forEach((star) => {
                const starVal = parseInt(star.getAttribute('data-value'));
                if (val > 0 && starVal <= val) {
                    star.classList.remove('far');
                    star.classList.add('fas');
                } else {
                    star.classList.remove('fas');
                    star.classList.add('far');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const stars = document.querySelectorAll('.modal-star');
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    setModalRating(val);
                });

                star.addEventListener('mouseover', function() {
                    const hoverVal = parseInt(this.getAttribute('data-value'));
                    stars.forEach(s => {
                        const sVal = parseInt(s.getAttribute('data-value'));
                        if (sVal <= hoverVal) {
                            s.classList.remove('far');
                            s.classList.add('fas');
                        } else {
                            s.classList.remove('fas');
                            s.classList.add('far');
                        }
                    });
                });

                star.addEventListener('mouseout', function() {
                    setModalRating(currentModalRating);
                });
            });
        });

        async function submitPerProductReview(event) {
            event.preventDefault();
            
            const orderId = document.getElementById('modal-order-id').value;
            const productId = document.getElementById('modal-product-id').value;
            const rating = parseInt(document.getElementById('modal-rating-value').value) || 0;
            const title = document.getElementById('modal-review-title').value.trim();
            const comment = document.getElementById('modal-review-comment').value.trim();

            if (rating <= 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Rating Required',
                        text: 'Please select a star rating (1 to 5) before submitting.',
                        confirmButtonColor: '#5c1e28'
                    });
                } else {
                    alert('Please select a star rating before submitting.');
                }
                return;
            }

            if (!comment) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Comment Required',
                        text: 'Please enter your review text before submitting.',
                        confirmButtonColor: '#5c1e28'
                    });
                } else {
                    alert('Please enter your review text before submitting.');
                }
                return;
            }

            // Close review modal pop-up first so confirmation popup appears clearly
            closeReviewModal();

            let isConfirmed = true;
            if (typeof Swal !== 'undefined') {
                const confirmResult = await Swal.fire({
                    title: 'Submit Review?',
                    text: 'Are you sure you want to submit your review for admin approval?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#5c1e28',
                    cancelButtonColor: '#888',
                    confirmButtonText: 'Yes, Submit',
                    cancelButtonText: 'Cancel'
                });
                isConfirmed = confirmResult.isConfirmed;
            } else {
                isConfirmed = confirm('Are you sure you want to submit your review for admin approval?');
            }

            if (!isConfirmed) {
                // Re-open review modal if user cancels confirmation
                document.getElementById('product-review-modal').style.display = 'flex';
                return;
            }

            try {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Submitting Review...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });
                }

                const response = await fetch(`/profile/orders/${orderId}/review`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: productId,
                        rating: rating,
                        title: title,
                        comment: comment
                    })
                });

                const data = await response.json();
                if (typeof Swal !== 'undefined') Swal.close();

                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Review Submitted',
                            text: data.message || 'Your review has been submitted for admin approval!',
                            confirmButtonColor: '#5c1e28'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        alert(data.message || 'Your review has been submitted for admin approval!');
                        window.location.reload();
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'Failed to submit review.',
                            confirmButtonColor: '#5c1e28'
                        });
                    } else {
                        alert(data.message || 'Failed to submit review.');
                    }
                }
            } catch (err) {
                console.error('Error submitting review:', err);
                if (typeof Swal !== 'undefined') Swal.close();
                alert('Something went wrong. Please try again.');
            }
        }
    </script>
