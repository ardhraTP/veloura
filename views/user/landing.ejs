<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Veloura - Haute Cosmetics</title>
    <meta name="description" content="Experience Veloura luxury cosmetics where heritage meets haute couture. Discover lipstick collections enriched with rich pigment and velvet finish.">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/home.css">
    <script src="/js/prevent-back.js"></script>

    <style>
        /* Landing Header Styling */
        .landing-header {
            padding: 30px 80px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }

        .landing-header .logo {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 600;
            color: var(--primary-red);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .landing-header .header-center {
            display: flex;
            gap: 45px;
            align-items: center;
        }

        .landing-header .header-center a {
            color: var(--text-dark);
            text-decoration: none;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s ease;
        }

        .landing-header .header-center a:hover {
            color: var(--primary-red);
        }

        .landing-header .header-auth {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .landing-header .login-btn {
            color: var(--text-dark);
            text-decoration: none;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 10px 18px;
            transition: color 0.3s ease;
        }

        .landing-header .login-btn:hover {
            color: var(--primary-red);
        }

        .landing-header .signup-btn {
            background-color: var(--primary-red);
            color: #FFFFFF;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 12px 26px;
            border-radius: 4px;
            transition: all 0.35s ease;
            box-shadow: 0 4px 15px rgba(92, 30, 40, 0.2);
        }

        .landing-header .signup-btn:hover {
            background-color: #3b1118;
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(92, 30, 40, 0.3);
        }

        @media (max-width: 992px) {
            .landing-header {
                padding: 20px 30px;
            }
            .landing-header .header-center {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="landing-header">
        <a href="/" class="logo">Veloura</a>
        <div class="header-center">
            <a href="/">Home</a>
            <a href="/products">Collections</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </div>
        <div class="header-auth">
            <a href="/login" class="login-btn">Login</a>
            <a href="/register" class="signup-btn">Sign Up</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">The Art of the Lip</h1>
            <p class="hero-description">
                Experience a collection where heritage meets haute couture. Pigment as rich as history, textures as soft as velvet.
            </p>
            <button class="shop-btn" onclick="window.location.href='/products'">Discover the Collection</button>
        </div>
        <div class="hero-image-container">
            <img src="/images/hero_bg.png" alt="Hero Lipstick Collection">
        </div>
    </section>

    <!-- Premium Category Section -->
    <section class="premium-section">
        <div class="section-header">
            <p class="section-subtitle">CURATED EXCELLENCE</p>
            <h2 class="section-title">The Premium category</h2>
        </div>

        <div class="product-grid">
            <div class="product-card" onclick="window.location.href='/products'">
                <div class="product-image-wrapper">
                    <img src="/images/mac_product.png" alt="Mac Cosmetics">
                </div>
                <div class="product-info">
                    <h3 class="product-brand">Mac Cosmetics <i class="fas fa-arrow-right" style="font-size: 14px; opacity: 0.7;"></i></h3>
                    <p class="product-category">RETRO VELVET FINISH</p>
                </div>
            </div>

            <div class="product-card" onclick="window.location.href='/products'">
                <div class="product-image-wrapper">
                    <img src="/images/maybelline_product.png" alt="Maybelline">
                </div>
                <div class="product-info">
                    <h3 class="product-brand">Maybelline <i class="fas fa-arrow-right" style="font-size: 14px; opacity: 0.7;"></i></h3>
                    <p class="product-category">LUSTRE SHINE FOCUS</p>
                </div>
            </div>

            <div class="product-card" onclick="window.location.href='/products'">
                <div class="product-image-wrapper">
                    <img src="/images/lakme_product.png" alt="Lakme">
                </div>
                <div class="product-info">
                    <h3 class="product-brand">Lakme <i class="fas fa-arrow-right" style="font-size: 14px; opacity: 0.7;"></i></h3>
                    <p class="product-category">SHEER HYDRATION</p>
                </div>
            </div>
        </div>

        <div class="pagination">
            <div class="pagination-line-container">
                <div class="pagination-line-active"></div>
            </div>
            <span class="pagination-text">01 / 03</span>
        </div>
    </section>

    <!-- New Collection Banner -->
    <section class="collection-banner">
        <div class="banner-content">
            <p class="banner-subtitle">LIMITED EDITION RELEASE</p>
            <h2 class="banner-title">Shop the New Collection</h2>
            <p class="banner-description">
                The Gilded Series: A harmonious blend of Macaroon artisanal waxcraft and contemporary pigment science.
            </p>
            <button class="explore-btn" onclick="window.location.href='/products'">EXPLORE NOW</button>
        </div>
    </section>

    <%- include('../partials/footer', { showSocialLinks: true }) %>

</body>
</html>
