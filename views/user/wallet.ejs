<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wallet - Veloura</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/prevent-back.js"></script>
    <style>
        :root {
            --primary-red: #5c1e28;
            --primary-green: #19B24B;
            --bg-beige: #FAF6F0;
            --box-beige: #FFF8F2;
            --text-dark: #2c2c2c;
            --text-light: #666666;
            --white: #ffffff;
            --border-color: #e8e4df;
        }

        body {
            background-color: var(--bg-beige);
            color: var(--text-dark);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Content Area layout matching image */
        .wallet-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* Available Balance Card */
        .balance-card {
            background: linear-gradient(135deg, #5c1e28 0%, #3b1118 100%);
            border: 1px solid rgba(197, 160, 89, 0.4);
            border-radius: 16px;
            padding: 40px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--white);
            box-shadow: 0 12px 35px rgba(92, 30, 40, 0.22);
            position: relative;
            overflow: hidden;
            transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .balance-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 45px rgba(92, 30, 40, 0.32);
            border-color: rgba(197, 160, 89, 0.8);
        }

        .balance-card h2 {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 500;
            margin: 0;
            letter-spacing: -0.5px;
        }

        .balance-value {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 600;
            margin: 0;
        }

        /* Middle Grid: Add Money & Transaction History */
        .middle-grid {
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            gap: 30px;
        }

        @media (max-width: 992px) {
            .middle-grid {
                grid-template-columns: 1fr;
            }
        }

        .premium-card {
            background: var(--white);
            border: 1px solid #E6DED4;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
        }

        .card-header-title {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 500;
            color: var(--primary-red);
            margin: 0 0 10px 0;
        }

        .card-subtitle {
            font-size: 12px;
            color: var(--text-light);
            margin-bottom: 25px;
        }

        /* Add Money Styles */
        .payment-options {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 30px;
        }

        .option-item {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .option-item input[type="radio"] {
            accent-color: var(--primary-red);
            width: 16px;
            height: 16px;
        }

        .option-item label {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
        }

        .amount-input-group {
            margin-bottom: 25px;
        }

        .amount-input-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-light);
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .currency-symbol {
            position: absolute;
            left: 15px;
            font-size: 16px;
            font-weight: 600;
            color: var(--text-dark);
        }

        .amount-input {
            width: 100%;
            padding: 14px 15px 14px 35px;
            border: 1px solid #E6DED4;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-dark);
            outline: none;
            background-color: var(--bg-beige);
            transition: border-color 0.3s;
        }

        .amount-input:focus {
            border-color: var(--primary-red);
        }

        .pay-btn {
            width: 100%;
            background-color: var(--primary-green);
            color: var(--white);
            border: none;
            border-radius: 8px;
            padding: 16px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .pay-btn:hover {
            background-color: #12933c;
            box-shadow: 0 4px 12px rgba(25, 178, 75, 0.2);
        }

        .top-up-card {
            width: 400px;
            max-width: 100%;
            height: 320px;
            align-self: start;
            box-sizing: border-box;
        }

        /* Pagination Styles */
        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #E6DED4;
        }

        .pagination-btn {
            background-color: var(--white);
            border: 1px solid #E6DED4;
            color: var(--text-dark);
            padding: 8px 16px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            outline: none;
        }

        .pagination-btn:hover:not(:disabled) {
            background-color: var(--primary-red);
            color: var(--white);
            border-color: var(--primary-red);
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-info {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-light);
        }

        /* Transaction History Styles */
        .history-controls {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .select-filter {
            padding: 8px 16px;
            border: 1px solid #E6DED4;
            border-radius: 6px;
            background-color: var(--white);
            color: var(--text-dark);
            font-size: 12px;
            font-weight: 600;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .select-filter:focus {
            border-color: var(--primary-red);
        }

        .history-table-wrapper {
            overflow-x: auto;
            border: 1px solid #E6DED4;
            border-radius: 8px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }

        .history-table th {
            background-color: var(--bg-beige);
            padding: 15px 20px;
            font-weight: 600;
            color: var(--text-light);
            border-bottom: 1px solid #E6DED4;
        }

        .history-table td {
            padding: 16px 20px;
            border-bottom: 1px solid #E6DED4;
            color: var(--text-dark);
        }

        .history-table tr:last-child td {
            border-bottom: none;
        }

        .history-table tr:nth-child(even) td {
            background-color: #FAF8F5;
        }

        .amount-cred {
            color: var(--primary-green);
            font-weight: 600;
        }

        .amount-deb {
            color: #d32f2f;
            font-weight: 600;
        }

        .badge-type {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 12px;
            display: inline-block;
        }

        .badge-cred {
            background-color: #E8F8F0;
            color: var(--primary-green);
        }

        .badge-deb {
            background-color: #FDE8E8;
            color: #d32f2f;
        }

        /* Referral Program Card */
        .referral-card {
            background: var(--white);
            border: 1px solid #E6DED4;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .referral-header {
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #E6DED4;
            padding-bottom: 20px;
        }

        .referral-header i {
            font-size: 24px;
            color: var(--primary-red);
        }

        .referral-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 500;
            color: var(--primary-red);
            margin: 0;
        }

        .referral-stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @media (max-width: 768px) {
            .referral-stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-box {
            background-color: #FAF8F5;
            border: 1px solid #E6DED4;
            border-radius: 8px;
            padding: 25px;
            text-align: center;
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 600;
            color: var(--primary-red);
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .share-earn-section {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .share-earn-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--primary-red);
        }

        .share-earn-desc {
            font-size: 13px;
            color: var(--text-light);
            margin-bottom: 5px;
            line-height: 1.5;
        }

        /* Copy Inputs */
        .copy-group {
            display: flex;
            gap: 15px;
        }

        @media (max-width: 576px) {
            .copy-group {
                flex-direction: column;
                gap: 10px;
            }
        }

        .copy-input-wrapper {
            flex: 1;
            display: flex;
            border: 1px solid #E6DED4;
            border-radius: 8px;
            overflow: hidden;
            background-color: #FAF8F5;
        }

        .copy-input-wrapper input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 14px 20px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-dark);
            outline: none;
        }

        .copy-btn {
            border: none;
            padding: 0 30px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: background-color 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .copy-btn.burgundy {
            background-color: var(--primary-red);
            color: var(--white);
        }

        .copy-btn.burgundy:hover {
            background-color: #3b1118;
        }

        .copy-btn.blue {
            background-color: #2563EB;
            color: var(--white);
        }

        .copy-btn.blue:hover {
            background-color: #1d4ed8;
        }

        /* Empty State */
        .no-referrals-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 40px 0;
            border-top: 1px solid #FAF6F0;
            margin-top: 20px;
        }

        .no-referrals-icon {
            font-size: 40px;
            color: #E6DED4;
            margin-bottom: 15px;
        }

        .no-referrals-title {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 500;
            color: var(--text-dark);
            margin: 0 0 8px 0;
        }

        .no-referrals-desc {
            font-size: 12px;
            color: var(--text-light);
            max-width: 300px;
            line-height: 1.5;
        }

        /* Responsive Layout adjustment */
        @media (max-width: 992px) {
            .main-container {
                gap: 30px;
            }
        }

        /* Referral Card Full-Width Centering Container */
        .referral-card-container {
            max-width: 1300px;
            margin: 0 auto 80px;
            padding: 0 80px;
            box-sizing: border-box;
        }

        .referral-card-container .referral-card {
            width: 100%;
        }

        @media (max-width: 992px) {
            .referral-card-container {
                padding: 0 40px;
                margin-bottom: 40px;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar Header -->
    <%- include('../partials/navbar') %>

    <!-- Main Profile Sidebar + Content Layout -->
    <div class="main-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/profile-sidebar') %>

        <!-- Content Area -->
        <main class="wallet-content">
            <!-- Available Balance Banner -->
            <div class="balance-card">
                <h2>Available Balance</h2>
                <div class="balance-value">₹<%= (user.walletBalance || 0).toFixed(2) %></div>
            </div>

            <!-- Middle Cards: Top Up & History -->
            <div class="middle-grid">
                <!-- Top Up Card -->
                <div class="premium-card top-up-card">
                    <h3 class="card-header-title">Add Cash to Wallet</h3>
                    <p class="card-subtitle">Enter the amount you wish to add to your wallet balance</p>

                    <form id="addMoneyForm" onsubmit="handleAddMoney(event)" novalidate>
                        <div class="amount-input-group">
                            <label for="amount">Enter amount:</label>
                            <div class="input-wrapper">
                                <span class="currency-symbol">₹</span>
                                <input type="number" id="amount" name="amount" class="amount-input" placeholder="e.g. 500" min="1" step="any">
                            </div>
                            <span id="amount-error" style="color: #d93025; font-size: 12px; margin-top: 5px; display: none; font-weight: 500;"></span>
                        </div>

                        <button type="submit" class="pay-btn">Add Cash</button>
                    </form>
                </div>

                <!-- Transaction History Card -->
                <div class="premium-card" style="display: flex; flex-direction: column;">
                    <h3 class="card-header-title">Transaction History</h3>
                    <p class="card-subtitle">List of recent debits and credits</p>

                    <div class="history-controls">
                        <select id="typeFilter" class="select-filter" onchange="filterTransactions()">
                            <option value="all">All Transactions</option>
                            <option value="Credited">Credited</option>
                            <option value="Debited">Debited</option>
                        </select>
                        <select id="sortOrder" class="select-filter" onchange="filterTransactions()">
                            <option value="desc">Newest First</option>
                            <option value="asc">Oldest First</option>
                        </select>
                    </div>

                    <div class="history-table-wrapper" style="flex: 1;">
                        <table class="history-table" id="txnTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Details / Method</th>
                                    <th>Amount</th>
                                    <th>Transaction</th>
                                </tr>
                            </thead>
                            <tbody id="txnTableBody">
                                <% if (user.walletHistory && user.walletHistory.length > 0) { %>
                                    <% 
                                        // Sort history descending by date initially
                                        let sortedHistory = [...user.walletHistory].sort((a, b) => new Date(b.date) - new Date(a.date));
                                    %>
                                    <% sortedHistory.forEach(tx => { %>
                                        <tr data-type="<%= tx.type %>" data-date="<%= new Date(tx.date).getTime() %>">
                                            <td><%= new Date(tx.date).toLocaleDateString('en-IN') %></td>
                                            <%
                                                let displayDescription = tx.description || 'Wallet Transaction';
                                                const descLower = displayDescription.toLowerCase();
                                                if (descLower.includes('referral') || descLower.includes('welcome bonus')) {
                                                    displayDescription = 'Referral';
                                                } else if (descLower.includes('cancelled') || descLower.includes('cancel')) {
                                                    displayDescription = 'Cancel Amount';
                                                } else if (descLower.includes('returned') || descLower.includes('return')) {
                                                    displayDescription = 'Return Amount';
                                                } else if (descLower.includes('added') || descLower.includes('top up') || descLower.includes('topup')) {
                                                    displayDescription = 'Added Cash';
                                                } else if (descLower.includes('payment') || descLower.includes('debit') || descLower.includes('order')) {
                                                    displayDescription = 'Order Payment';
                                                }
                                            %>
                                            <td style="font-weight: 600; font-size: 13px; color: var(--text-dark);"><%= displayDescription %></td>
                                            <td class="<%= tx.type === 'Credited' ? 'amount-cred' : 'amount-deb' %>">
                                                <%= tx.type === 'Credited' ? '+' : '-' %>₹<%= tx.amount.toFixed(2) %>
                                            </td>
                                            <td>
                                                <span class="badge-type <%= tx.type === 'Credited' ? 'badge-cred' : 'badge-deb' %>">
                                                    <%= tx.type %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr id="noTxnRow">
                                        <td colspan="4" style="text-align: center; color: var(--text-light); padding: 30px;">
                                            No transactions recorded yet.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination Controls -->
                    <div id="paginationControls" class="pagination-container" style="display: none;">
                        <button class="pagination-btn" id="prevPageBtn" onclick="changePage(-1)">
                            <i class="fas fa-chevron-left"></i> Prev
                        </button>
                        <span class="pagination-info" id="pageInfo">Page 1 of 1</span>
                        <button class="pagination-btn" id="nextPageBtn" onclick="changePage(1)">
                            Next <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Referral Program Card -->
    <div class="referral-card-container">
        <div class="referral-card">
            <div class="referral-header">
                <i class="fas fa-user-plus"></i>
                <h2>Referral Program</h2>
            </div>

            <!-- Referral stats -->
            <div class="referral-stats-grid">
                <div class="stat-box">
                    <div class="stat-number">₹<%= (user.referralEarnings || 0).toFixed(2) %></div>
                    <div class="stat-label">Total Earned</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number"><%= user.referredCount || 0 %></div>
                    <div class="stat-label">Friends Referred</div>
                </div>
            </div>

            <!-- Code and Link section -->
            <div class="share-earn-section">
                <div class="share-earn-title">Share & Earn</div>
                <p class="share-earn-desc">Invite friends and earn ₹200 for each successful referral. Your friend gets ₹100 too!</p>

                <!-- Copy Promo Code -->
                <div class="copy-group">
                    <div class="copy-input-wrapper">
                        <input type="text" id="promoCode" value="<%= user.referralCode %>" readonly>
                    </div>
                    <button class="copy-btn burgundy" onclick="copyText('promoCode', 'Referral Code copied!')">
                        <i class="far fa-copy"></i> Copy
                    </button>
                </div>

                <!-- Copy Referral Link -->
                <div class="copy-group">
                    <div class="copy-input-wrapper">
                        <input type="text" id="referralLink" value="" readonly>
                    </div>
                    <button class="copy-btn blue" onclick="copyText('referralLink', 'Referral Link copied!')">
                        <i class="fas fa-link"></i> Copy Link
                    </button>
                </div>
            </div>

            <!-- Empty State / Graphic -->
            <div class="no-referrals-state">
                <div class="no-referrals-icon">
                    <i class="fas fa-user-friends"></i>
                </div>
                <h3 class="no-referrals-title">No Referrals Yet</h3>
                <p class="no-referrals-desc">Share your referral code or link to start earning rewards!</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <!-- Client-side Scripts -->
    <script>
        // Clear error styling/message when typing starts
        document.addEventListener('DOMContentLoaded', function() {
            const amountInput = document.getElementById('amount');
            if (amountInput) {
                amountInput.addEventListener('input', function() {
                    const errorSpan = document.getElementById('amount-error');
                    if (errorSpan) errorSpan.style.display = 'none';
                    amountInput.style.borderColor = '';
                });
            }
        });

        // Handle Top Up Form Submission via Fetch
        function handleAddMoney(event) {
            event.preventDefault();
            const form = event.target;
            const amountInput = document.getElementById('amount');
            const errorSpan = document.getElementById('amount-error');
            const amountVal = amountInput.value.trim();
            const paymentMethod = 'Online Payment';

            if (!amountVal) {
                if (errorSpan) {
                    errorSpan.textContent = 'Please enter an amount.';
                    errorSpan.style.display = 'block';
                }
                amountInput.style.borderColor = '#d93025';
                return;
            }

            const amount = parseFloat(amountVal);
            if (isNaN(amount) || amount <= 0) {
                if (errorSpan) {
                    errorSpan.textContent = 'Please enter a valid positive number to add funds.';
                    errorSpan.style.display = 'block';
                }
                amountInput.style.borderColor = '#d93025';
                return;
            }

            if (errorSpan) errorSpan.style.display = 'none';
            amountInput.style.borderColor = '';

            Swal.fire({
                title: 'Confirm Top Up',
                text: `Are you sure you want to add ₹${amount.toFixed(2)} to your wallet?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#19B24B',
                cancelButtonColor: '#aaa',
                confirmButtonText: 'Yes, Proceed',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        text: 'Simulating secure payment gateway connection...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Send POST request to backend
                    fetch('/profile/wallet/add-money', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ amount, paymentMethod })
                    })
                    .then(response => response.json())
                    .then(data => {
                        Swal.close();
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Payment Success!',
                                text: data.message,
                                confirmButtonColor: '#5c1e28',
                                allowOutsideClick: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Payment Failed',
                                text: data.message || 'Something went wrong.',
                                confirmButtonColor: '#5c1e28'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error adding money:', error);
                        Swal.close();
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error',
                            text: 'Failed to complete top-up transaction. Please try again.',
                            confirmButtonColor: '#5c1e28'
                        });
                    });
                }
            });
        }

        // Copy Text utility
        function copyText(elementId, successMsg) {
            const copyInput = document.getElementById(elementId);
            if (!copyInput) return;

            copyInput.select();
            copyInput.setSelectionRange(0, 99999); // For mobile devices

            navigator.clipboard.writeText(copyInput.value)
                .then(() => {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: successMsg,
                        showConfirmButton: false,
                        timer: 2000
                    });
                })
                .catch(err => {
                    console.error('Failed to copy text: ', err);
                });
        }

        // Pagination State Variables
        let currentPage = 1;
        const rowsPerPage = 6;

        function filterTransactions() {
            currentPage = 1;
            renderTransactionsTable();
        }

        function changePage(direction) {
            currentPage += direction;
            renderTransactionsTable();
        }

        // Filtering, Sorting, and Paginated Rendering of Transactions Table Client-side
        function renderTransactionsTable() {
            const typeFilter = document.getElementById('typeFilter').value;
            const sortOrder = document.getElementById('sortOrder').value;
            const tableBody = document.getElementById('txnTableBody');
            
            if (!tableBody) return;

            const rows = Array.from(tableBody.querySelectorAll('tr:not(#noTxnRow)'));
            if (rows.length === 0) return;

            // 1. Filter rows and collect matching ones
            const filteredRows = [];
            rows.forEach(row => {
                const rowType = row.getAttribute('data-type');
                if (typeFilter === 'all' || rowType === typeFilter) {
                    filteredRows.push(row);
                }
                // Hide all initially
                row.style.display = 'none';
            });

            const visibleRowsCount = filteredRows.length;

            // Handle empty state row and pagination container
            let noTxnRow = document.getElementById('noTxnRow');
            const paginationControls = document.getElementById('paginationControls');

            if (visibleRowsCount === 0) {
                if (!noTxnRow) {
                    noTxnRow = document.createElement('tr');
                    noTxnRow.id = 'noTxnRow';
                    noTxnRow.innerHTML = `<td colspan="4" style="text-align: center; color: var(--text-light); padding: 30px;">No transactions match the selected filter.</td>`;
                    tableBody.appendChild(noTxnRow);
                } else {
                    noTxnRow.style.display = '';
                    noTxnRow.querySelector('td').textContent = 'No transactions match the selected filter.';
                }
                if (paginationControls) paginationControls.style.display = 'none';
                return;
            } else if (noTxnRow) {
                noTxnRow.style.display = 'none';
            }

            // 2. Sort the filtered rows
            filteredRows.sort((a, b) => {
                const dateA = parseInt(a.getAttribute('data-date'));
                const dateB = parseInt(b.getAttribute('data-date'));
                return sortOrder === 'desc' ? dateB - dateA : dateA - dateB;
            });

            // 3. Re-append sorted rows to table body
            filteredRows.forEach(row => {
                tableBody.appendChild(row);
            });

            // 4. Paginate
            const totalPages = Math.ceil(visibleRowsCount / rowsPerPage);
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;

            const pageRows = filteredRows.slice(startIndex, endIndex);
            pageRows.forEach(row => {
                row.style.display = '';
            });

            // Update pagination controls display
            if (paginationControls) {
                if (totalPages > 1) {
                    paginationControls.style.display = 'flex';
                    document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
                    document.getElementById('prevPageBtn').disabled = (currentPage === 1);
                    document.getElementById('nextPageBtn').disabled = (currentPage === totalPages);
                } else {
                    paginationControls.style.display = 'none';
                }
            }
        }

        // Initialize referral link and table pagination on page load
        document.addEventListener('DOMContentLoaded', function() {
            const refLinkInput = document.getElementById('referralLink');
            if (refLinkInput) {
                refLinkInput.value = window.location.origin + '/register?ref=' + '<%= user.referralCode %>';
            }
            // Load and paginate the table
            filterTransactions();
        });
    </script>
</body>
</html>
