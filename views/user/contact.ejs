<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Veloura</title>
    <meta name="description" content="Reach out to Veloura for personalized beauty consultations or inquiries regarding our luxury cosmetics collections.">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/contact.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/prevent-back.js"></script>
</head>
<body>

    <%- include('../partials/navbar') %>

    <main class="contact-main">
        <!-- Centered Header Section -->
        <div class="contact-header">
            <h1 class="contact-title">Contact Us</h1>
            <p class="contact-subtitle">
                We invite you to reach out for personalized beauty consultations or any inquiries regarding our curated collections.
            </p>
        </div>

        <!-- Main Two-Column Contact Layout -->
        <div class="contact-container">
            
            <!-- Left Column: Contact Details Card -->
            <div class="contact-info-card">
                
                <!-- Call To Us Block -->
                <div class="info-block">
                    <div class="info-header">
                        <div class="info-icon-box">
                            <i class="fas fa-phone-alt"></i>
                        </div>
                        <h3 class="info-heading">Call To Us</h3>
                    </div>
                    <p class="info-subtext">We are available 24/7, 7 days a week.</p>
                    <p class="info-detail">Phone : 8943264154</p>
                </div>

                <div class="info-divider"></div>

                <!-- Write To Us Block -->
                <div class="info-block">
                    <div class="info-header">
                        <div class="info-icon-box">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <h3 class="info-heading">Write To Us</h3>
                    </div>
                    <p class="info-subtext">Fill out our form and we will contact you within 24 hours.</p>
                    <p class="info-detail">Emails: ardhraardhra407@gmail.com</p>
                </div>

            </div>

            <!-- Right Column: Contact Inquiry Form Card -->
            <div class="contact-form-card">
                <form id="contactForm" novalidate>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label" for="name">Your Name *</label>
                            <input type="text" id="name" name="name" class="form-input" placeholder="Your Name">
                            <span class="field-error" id="nameError"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="email">Your Email *</label>
                            <input type="email" id="email" name="email" class="form-input" placeholder="Your Email">
                            <span class="field-error" id="emailError"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="phone">Your Phone *</label>
                            <input type="tel" id="phone" name="phone" class="form-input" placeholder="Your Phone">
                            <span class="field-error" id="phoneError"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="message">Your Message *</label>
                        <textarea id="message" name="message" class="form-textarea" placeholder="Type your message here..."></textarea>
                        <span class="field-error" id="messageError"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" id="sendBtn" class="btn-send">Send Message</button>
                    </div>
                </form>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // Helper function to display field-wise error
        function showFieldError(inputId, errorId, message) {
            const inputEl = document.getElementById(inputId);
            const errorEl = document.getElementById(errorId);
            if (inputEl && errorEl) {
                inputEl.classList.add('is-invalid');
                errorEl.textContent = message;
                errorEl.style.display = 'block';
            }
        }

        // Helper function to clear field-wise error
        function clearFieldError(inputId, errorId) {
            const inputEl = document.getElementById(inputId);
            const errorEl = document.getElementById(errorId);
            if (inputEl && errorEl) {
                inputEl.classList.remove('is-invalid');
                errorEl.textContent = '';
                errorEl.style.display = 'none';
            }
        }

        // Define form fields and error IDs
        const formFields = [
            { inputId: 'name', errorId: 'nameError' },
            { inputId: 'email', errorId: 'emailError' },
            { inputId: 'phone', errorId: 'phoneError' },
            { inputId: 'message', errorId: 'messageError' }
        ];

        // Clear ALL errors across all fields as soon as the user starts typing in ANY field
        formFields.forEach(field => {
            const element = document.getElementById(field.inputId);
            if (element) {
                element.addEventListener('input', function() {
                    formFields.forEach(f => clearFieldError(f.inputId, f.errorId));
                });
            }
        });

        // Form submission with field-wise validation
        document.getElementById('contactForm').addEventListener('submit', async function(event) {
            event.preventDefault();

            // Clear any previous error states
            formFields.forEach(f => clearFieldError(f.inputId, f.errorId));

            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const message = document.getElementById('message').value.trim();
            const sendBtn = document.getElementById('sendBtn');

            let isValid = true;

            // Validate Name
            if (!name) {
                showFieldError('name', 'nameError', 'Please enter your name.');
                isValid = false;
            } else if (name.length < 2) {
                showFieldError('name', 'nameError', 'Name must be at least 2 characters long.');
                isValid = false;
            }

            // Validate Email
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email) {
                showFieldError('email', 'emailError', 'Please enter your email address.');
                isValid = false;
            } else if (!emailRegex.test(email)) {
                showFieldError('email', 'emailError', 'Please enter a valid email address (e.g., name@example.com).');
                isValid = false;
            }

            // Validate Phone
            const phoneRegex = /^[0-9]{10}$/;
            if (!phone) {
                showFieldError('phone', 'phoneError', 'Please enter your phone number.');
                isValid = false;
            } else if (!phoneRegex.test(phone)) {
                showFieldError('phone', 'phoneError', 'Please enter a valid 10-digit phone number.');
                isValid = false;
            }

            // Validate Message
            if (!message) {
                showFieldError('message', 'messageError', 'Please enter your message.');
                isValid = false;
            } else if (message.length < 5) {
                showFieldError('message', 'messageError', 'Message must be at least 5 characters long.');
                isValid = false;
            }

            // Stop if any field is invalid
            if (!isValid) {
                return;
            }

            // Disable button during network request
            sendBtn.disabled = true;
            sendBtn.textContent = 'SENDING...';

            try {
                const response = await fetch('/contact', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name, email, phone, message })
                });

                const data = await response.json();
                sendBtn.disabled = false;
                sendBtn.textContent = 'SEND MESSAGE';

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Message Sent!',
                        text: data.message || 'Thank you for reaching out to Veloura. We will get back to you shortly.',
                        confirmButtonColor: '#5c1e28'
                    });

                    // Reset form and errors
                    document.getElementById('contactForm').reset();
                    formFields.forEach(f => clearFieldError(f.inputId, f.errorId));
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed to Send',
                        text: data.message || 'Something went wrong. Please try again.',
                        confirmButtonColor: '#5c1e28'
                    });
                }
            } catch (error) {
                console.error('Contact submit error:', error);
                sendBtn.disabled = false;
                sendBtn.textContent = 'SEND MESSAGE';
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while sending your message. Please try again.',
                    confirmButtonColor: '#5c1e28'
                });
            }
        });
    </script>
</body>
</html>
