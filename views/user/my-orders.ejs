<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | Veloura</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/profile.css">
    <script src="/js/prevent-back.js"></script>
    <style>
        body {
            background-color: #FAF6F0;
            color: #2C2C2C;
            font-family: 'Inter', sans-serif;
        }

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 120px 20px 80px 20px;
            display: flex;
            gap: 40px;
        }

        .content-area {
            flex: 1;
            min-width: 0;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 500;
            color: #5C1E28;
            margin-top: 0;
            margin-bottom: 35px;
            letter-spacing: 0.5px;
        }

        .orders-list-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Order Card Style */
        .order-card-link {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: transform 0.2s ease;
        }

        .order-card-link:hover {
            transform: translateY(-2px);
        }

        /* Grouped Order Card Styles */
        .order-card {
            background: #FFFFFF;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            border: 1px solid #F0ECE6;
            margin-bottom: 25px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .order-card:hover {
            box-shadow: 0 6px 24px rgba(92, 30, 40, 0.05);
            border-color: #E6DED4;
        }

        .order-header {
            background-color: #FAF8F5;
            padding: 18px 30px;
            border-bottom: 1px solid #F0ECE6;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .order-meta-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .meta-label {
            font-size: 10px;
            font-weight: 700;
            color: #999999;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .meta-value {
            font-size: 14px;
            color: #2C2C2C;
            font-weight: 600;
        }

        .order-status-right {
            display: flex;
            align-items: center;
        }

        .order-body {
            padding: 24px 30px;
        }

        .order-products-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .order-product-row {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #FAF6F0;
        }

        .order-product-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .order-product-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #F0ECE6;
            background-color: #FAF6F0;
        }

        .order-product-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .order-product-title {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            font-weight: 500;
            color: #2C2C2C;
            margin: 0;
        }

        .order-product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .product-meta-badge {
            font-size: 11px;
            color: #666666;
            background-color: #FAF6F0;
            padding: 2px 10px;
            border-radius: 12px;
            font-weight: 500;
        }

        .status-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Indicator Dot Colors */
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .status-dot.yellow {
            background-color: #F59E0B;
        }

        .status-dot.green {
            background-color: #10B981;
        }

        .status-dot.red {
            background-color: #EF4444;
        }

        /* Status subtext styling */
        .status-subtext {
            font-size: 11px;
            color: #888888;
            margin: 0;
        }

        .status-subtext.rate-link {
            color: #C02626;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .empty-orders-card {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 50px 30px;
            text-align: center;
            border: 1px solid #F0ECE6;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .empty-orders-card i {
            font-size: 48px;
            color: #EAE5DF;
            margin-bottom: 20px;
        }

        .empty-orders-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            margin-bottom: 10px;
            color: #2C2C2C;
        }

        .empty-orders-card p {
            color: #666666;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .btn-shop-now {
            display: inline-block;
            background-color: #5C1E28;
            color: #FFFFFF;
            padding: 12px 30px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .btn-shop-now:hover {
            background-color: #3b1118;
            box-shadow: 0 4px 10px rgba(92, 30, 40, 0.15);
        }

        @media (max-width: 992px) {
            .main-container {
                flex-direction: column;
                gap: 30px;
                padding-top: 100px;
            }
        }

        @media (max-width: 768px) {
            .order-item-card {
                flex-direction: column;
                align-items: flex-start;
                padding: 20px;
                gap: 15px;
            }

            .order-item-price-center {
                text-align: left;
                min-width: 0;
            }

            .order-item-status-right {
                align-items: flex-start;
                min-width: 0;
            }
        }

        /* Pagination */
        .pagination-area {
            display: flex;
            justify-content: center;
            margin-top: 35px;
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
        }

        .page-btn {
            min-width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #E6DED4;
            background-color: white;
            color: #2C2C2C;
            font-size: 12px;
            font-weight: 500;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .page-btn:hover {
            background-color: #FAF6F0;
        }

        .page-btn.active {
            background-color: #5C1E28;
            color: white;
            border-color: #5C1E28;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="main-container">
        <%- include('../partials/profile-sidebar') %>

        <main class="content-area">
            <h1 class="page-title">My Orders</h1>
            <!-- Search bar for orders -->
            <div class="search-container" style="margin-bottom: 25px;">
                <form action="/profile/orders" method="GET" style="display: flex; gap: 10px;">
                    <input type="text" name="search" placeholder="Search by Order ID, Product Name, Brand, or Status..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" style="flex: 1; padding: 12px 16px; border: 1px solid #E6DED4; border-radius: 6px; background-color: #FFFFFF; font-family: inherit; font-size: 14px; outline: none;">
                    <button type="submit" style="background-color: #5C1E28; color: #FFFFFF; border: none; border-radius: 6px; padding: 12px 24px; font-weight: 600; font-size: 13px; text-transform: uppercase; cursor: pointer;">Search</button>
                    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <a href="/profile/orders" style="display: flex; align-items: center; justify-content: center; background-color: #EAE5DF; color: #5C1E28; border: 1px solid #5C1E28; border-radius: 6px; padding: 12px 20px; font-weight: 600; font-size: 13px; text-transform: uppercase; text-decoration: none;">Clear</a>
                    <% } %>
                </form>
            </div>

            <div class="orders-list-container">
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(function(order) { %>
                        <a href="/profile/orders/<%= order._id %>" class="order-card-link">
                            <div class="order-card">
                                <!-- Order Card Header -->
                                <div class="order-header">
                                    <div class="order-meta-info">
                                        <span class="meta-label">ORDER PLACED</span>
                                        <span class="meta-value"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                    </div>
                                    <% 
                                        let displayTotal = order.totalAmount;
                                        if (order.orderStatus === 'Cancelled' || order.totalAmount === 0) {
                                            const subtotal = order.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                                            const shipping = order.shippingFee || 0;
                                            const tax = Math.round(subtotal * 0.05);
                                            const discount = order.discount || 0;
                                            displayTotal = Math.max(0, subtotal + shipping + tax - discount);
                                        }
                                    %>
                                    <div class="order-meta-info">
                                        <span class="meta-label">TOTAL AMOUNT</span>
                                        <span class="meta-value">₹<%= displayTotal.toFixed(2) %></span>
                                    </div>
                                    <div class="order-meta-info">
                                        <span class="meta-label">ORDER ID</span>
                                        <span class="meta-value" style="color: #5C1E28; font-weight: 600;"><%= order.orderId %></span>
                                    </div>
                                    
                                    <!-- Status Indicator -->
                                    <% 
                                        let dotColor = 'yellow';
                                        let statusText = order.orderStatus || 'Pending';
                                        const isPaymentFailed = order.paymentStatus === 'Failed';

                                        if (isPaymentFailed) {
                                            dotColor = 'red';
                                            statusText = 'PAYMENT FAILED';
                                        } else if (order.orderStatus === 'Delivered') {
                                            dotColor = 'green';
                                        } else if (order.orderStatus === 'Cancelled' || order.orderStatus === 'Returned') {
                                            dotColor = 'red';
                                        }
                                    %>
                                    <div class="order-status-right" style="display: flex; align-items: center; gap: 12px;">
                                        <div class="status-header">
                                            <span class="status-dot <%= dotColor %>"></span>
                                            <span><%= statusText %></span>
                                        </div>
                                        <% if (isPaymentFailed) { %>
                                            <button type="button" 
                                                    class="btn-retry-payment"
                                                    onclick="event.preventDefault(); event.stopPropagation(); retryPayment('<%= order.orderId %>');"
                                                    style="background-color: #5C1E28; color: #ffffff; border: none; padding: 8px 16px; border-radius: 20px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.8px; box-shadow: 0 2px 8px rgba(92, 30, 40, 0.2); transition: all 0.2s;">
                                                <i class="fas fa-redo"></i> Retry Payment
                                            </button>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Order Card Body (Grouped Products) -->
                                <div class="order-body">
                                    <% if (order.items && order.items.length > 0) { %>
                                        <div class="order-products-list">
                                            <% order.items.forEach(function(item) { %>
                                                <div class="order-product-row">
                                                    <img src="<%= (item.variant && item.variant.images && item.variant.images.length > 0) ? item.variant.images[0] : '/images/default.jpg' %>" alt="Product Image" class="order-product-img">
                                                    <div class="order-product-info">
                                                        <h4 class="order-product-title"><%= (item.product && item.product.productName) ? item.product.productName : 'Product Name' %></h4>
                                                        <div class="order-product-meta">
                                                            <% if (item.variant && item.variant.color) { %>
                                                                <span class="product-meta-badge">Shade: <%= item.variant.color %></span>
                                                            <% } %>
                                                            <span class="product-meta-badge">Qty: <%= item.quantity %></span>
                                                            <span class="product-meta-badge">Price: ₹<%= item.price.toFixed(2) %></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                <% } else { %>
                    <div class="empty-orders-card">
                        <i class="fas fa-box-open"></i>
                        <h3>No Orders Yet</h3>
                        <p>Explore our premium cosmetics collection and make your first purchase!</p>
                        <a href="/products" class="btn-shop-now">Continue Shopping</a>
                    </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (locals.totalPages && totalPages > 1) { %>
                <div class="pagination-area">
                    <div class="pagination-controls">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" class="page-btn">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        <% } %>

                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <a href="?page=<%= i %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" 
                               class="page-btn <%= currentPage === i ? 'active' : '' %>">
                               <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" class="page-btn">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </main>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function retryPayment(orderId) {
            try {
                Swal.fire({
                    title: 'Initializing Payment...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                const response = await fetch('/order/retry-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: orderId })
                });

                const data = await response.json();
                Swal.close();

                if (!data.success) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Stock / Payment Error',
                        text: data.message || 'Unable to retry payment.',
                        confirmButtonColor: '#5c1e28'
                    });
                    return;
                }

                const options = {
                    key: data.keyId,
                    amount: Math.round(data.amount * 100),
                    currency: 'INR',
                    name: 'Veloura',
                    description: 'Retry Payment for Order ' + data.orderId,
                    order_id: data.razorpayOrderId,
                    prefill: {
                        name: data.userName || '',
                        email: data.userEmail || '',
                        contact: data.userPhone || ''
                    },
                    theme: { color: '#5c1e28' },
                    handler: async function (paymentResponse) {
                        Swal.fire({
                            title: 'Verifying Payment...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        try {
                            const verifyRes = await fetch('/checkout/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: paymentResponse.razorpay_order_id,
                                    razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                    razorpay_signature: paymentResponse.razorpay_signature,
                                    orderId: data.orderId
                                })
                            });

                            const verifyData = await verifyRes.json();
                            Swal.close();

                            if (verifyData.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Payment Successful!',
                                    text: 'Your payment has been received successfully.',
                                    confirmButtonColor: '#5c1e28'
                                }).then(() => {
                                    window.location.href = `/order/payment-success?orderId=${data.orderId}`;
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Verification Failed',
                                    text: verifyData.message || 'Payment verification failed.',
                                    confirmButtonColor: '#5c1e28'
                                });
                            }
                        } catch (err) {
                            console.error('Error verifying payment:', err);
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Failed to verify payment.',
                                confirmButtonColor: '#5c1e28'
                            });
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Payment Failed',
                        text: 'Payment was not completed. You can try again anytime from My Orders.',
                        confirmButtonColor: '#5c1e28'
                    });
                });
                rzp.open();
            } catch (error) {
                console.error('Error retrying payment:', error);
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'A network error occurred. Please try again.',
                    confirmButtonColor: '#5c1e28'
                });
            }
        }
    </script>
</body>
</html>
