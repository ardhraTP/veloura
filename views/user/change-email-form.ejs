<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Email Address - Veloura</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-red: #5c1e28;
            --bg-beige: #fdfbf9;
            --box-beige: #f4f1ec;
            --text-dark: #2c2c2c;
            --text-light: #666666;
            --white: #ffffff;
            --border-color: #e8e4df;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background-color: var(--bg-beige);
            -webkit-font-smoothing: antialiased;
        }

        /* Main Container */
        .main-container {
            display: flex;
            max-width: 1300px;
            margin: 20px auto 80px;
            gap: 60px;
            padding: 0 80px;
        }

        /* Content Area */
        .content-area {
            flex: 1;
            background: var(--white);
            border-radius: 20px;
            padding: 50px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 500;
            color: var(--primary-red);
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--text-light);
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--primary-red);
        }

        .form-group input:read-only {
            background-color: #f5f5f5;
            cursor: not-allowed;
            color: var(--text-light);
        }

        .form-actions {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-primary {
            background-color: var(--primary-red);
            color: var(--white);
        }

        .btn-primary:hover {
            background-color: #40131b;
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--text-light);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background-color: #f5f5f5;
        }

        .error-message {
            background-color: #fee;
            color: #c33;
            padding: 12px 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 3px solid #c33;
            font-size: 13px;
        }

        .field-error {
            color: #c33;
            font-size: 11px;
            margin-top: 5px;
            display: block;
        }

        .input-error {
            border-color: #c33 !important;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .main-container {
                flex-direction: column;
                padding: 0 40px;
            }
        }
    </style>
    <script src="/js/prevent-back.js"></script>
</head>
<body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Main Container -->
    <div class="main-container">
        <!-- Sidebar -->
        <%- include('../partials/profile-sidebar', { activeTab: 'profile' }) %>

        <!-- Content Area -->
        <main class="content-area">
            <h1 class="page-title">Change Email Address</h1>
            <p class="page-subtitle">Your existing email has been verified via OTP. Now, enter your new email address to send a verification code.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message"><%= error %></div>
            <% } %>

            <form action="/profile/change-email/form" method="POST" id="changeEmailForm">
                <div class="form-group">
                    <label for="existingEmail">Existing Email Address</label>
                    <input type="email" id="existingEmail" name="existingEmail" value="<%= user.email %>" readonly>
                </div>

                <div class="form-group">
                    <label for="newEmail">New Email Address *</label>
                    <input type="email" id="newEmail" name="newEmail" placeholder="Enter new email address" required>
                    <span class="field-error" id="newEmailError"></span>
                </div>

                <div class="form-group">
                    <label for="confirmEmail">Confirm New Email Address *</label>
                    <input type="email" id="confirmEmail" name="confirmEmail" placeholder="Re-enter new email address" required>
                    <span class="field-error" id="confirmEmailError"></span>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="window.location.href='/profile/edit'">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send Verification Code</button>
                </div>
            </form>
        </main>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <script>
        document.getElementById('changeEmailForm').addEventListener('submit', function(e) {
            const newEmail = document.getElementById('newEmail').value.trim();
            const confirmEmail = document.getElementById('confirmEmail').value.trim();
            const existingEmail = document.getElementById('existingEmail').value.trim();

            const newEmailError = document.getElementById('newEmailError');
            const confirmEmailError = document.getElementById('confirmEmailError');

            newEmailError.textContent = '';
            confirmEmailError.textContent = '';
            document.getElementById('newEmail').classList.remove('input-error');
            document.getElementById('confirmEmail').classList.remove('input-error');

            let hasError = false;

            if (!newEmail) {
                newEmailError.textContent = 'Please enter a new email address';
                document.getElementById('newEmail').classList.add('input-error');
                hasError = true;
            } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
                newEmailError.textContent = 'Please enter a valid email address';
                document.getElementById('newEmail').classList.add('input-error');
                hasError = true;
            } else if (newEmail.toLowerCase() === existingEmail.toLowerCase()) {
                newEmailError.textContent = 'New email address must be different from existing email';
                document.getElementById('newEmail').classList.add('input-error');
                hasError = true;
            }

            if (!confirmEmail) {
                confirmEmailError.textContent = 'Please confirm your new email address';
                document.getElementById('confirmEmail').classList.add('input-error');
                hasError = true;
            } else if (newEmail !== confirmEmail) {
                confirmEmailError.textContent = 'Email addresses do not match';
                document.getElementById('confirmEmail').classList.add('input-error');
                hasError = true;
            }

            if (hasError) {
                e.preventDefault();
            }
        });
    </script>
</body>
</html>
